# Balancer V2
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8
BALANCER_FEE_BP=0                            # 0% fee for flash loans

# ========================================
# DEX Protocol Addresses
# ========================================
