CAMELOT_FACTORY=0x6EcCab422D763aC031210895C81787E87B91425

# Curve
CURVE_REGISTRY=0x445FE580eF8d70FF569aB36e80c647af338db351

# Balancer
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8

