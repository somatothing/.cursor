TRADERJOE_ROUTER=0x60aE616a2155Ee3d9A68541Ba4544862310933d4

# ========================================
# Token Addresses (Arbitrum)
# ========================================
WETH=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
USDC=0xA0b86a33E6441E95C9F6e5d8f2Bb3C8D4E5E5E5E
USDT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
DAI=0xDA10009cBd5D07dd0CeCc66161FC93D7c9000da1
WBTC=0x2f2a2543B76A4166549F7aaB2e75Bef0aefC5B0f
ARB=0x912CE59144191C1204E64559FE8253a0e49E6548

# Stablecoins
FRAX=0x17FC002b466eEc40DaE837Fc4bE5c67993ddBd6F
LUSD=0x93b346b6BC2548dA6A1E7d98E9a421B42541425b

# ========================================
# Timeboost Configuration
# ========================================
TIMEBOOST_ENABLED=true
EXPRESS_LANE_CONTROLLER=0x0000000000000000000000000000000000000000  # TBD
TIMEBOOST_AUCTION_DURATION=60                # 60 seconds
TIMEBOOST_MIN_BID_INCREMENT=1000000000000000 # 0.001 ETH
TIMEBOOST_MAX_BID=10000000000000000000       # 10 ETH

# Bidding Strategy
TIMEBOOST_BASE_BID_PERCENTAGE=20             # 20% of expected profit
TIMEBOOST_COMPETITION_MULTIPLIER=150         # 1.5x for high competition
TIMEBOOST_TIME_SENSITIVITY_THRESHOLD=90      # 90% time sensitivity

# ========================================
# Regulatory Compliance
# ========================================
COMPLIANCE_ENABLED=true
COMPLIANCE_JURISDICTION=US                   # US, EU, UK, etc.

# Reporting Thresholds
LARGE_TX_THRESHOLD=10000000000000000000000   # $10,000 USD equivalent
MAX_DAILY_VOLUME=100000000000000000000000    # $100,000 USD equivalent
SUSPICIOUS_ACTIVITY_THRESHOLD=70             # 70% suspicion score

# MiCA Compliance (EU)
MICA_ENABLED=false
MICA_REPORTING_THRESHOLD=1000000000000000000000  # €1,000 equivalent

# CFTC/SEC Compliance (US)
CFTC_REPORTING_ENABLED=true
SEC_REPORTING_ENABLED=true
FINRA_REPORTING_ENABLED=false

# ========================================
# Monitoring & Alerting
# ========================================
MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERT_EMAIL=alerts@yourcompany.com

# Performance Monitoring
PERFORMANCE_TRACKING_ENABLED=true
METRICS_EXPORT_INTERVAL=60                  # 60 seconds
HEALTH_CHECK_INTERVAL=30                    # 30 seconds

# Risk Alerts
RISK_ALERT_DRAWDOWN_BP=1500                 # 15% drawdown alert
RISK_ALERT_DAILY_LOSS_BP=500                # 5% daily loss alert
RISK_ALERT_VAR_BREACH=true                  # VaR breach alerts

# ========================================
# Security Settings
# ========================================
# Multi-signature
MULTISIG_ENABLED=false
MULTISIG_THRESHOLD=2
MULTISIG_SIGNERS=0x...,0x...,0x...

# Hardware Security Module
HSM_ENABLED=false
HSM_PROVIDER=aws                            # aws, azure, local

# Rate Limiting
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=100
MAX_TRANSACTIONS_PER_HOUR=50

# ========================================
# Development & Testing
# ========================================
DEBUG_MODE=false
LOG_LEVEL=info                              # error, warn, info, debug, trace
TEST_MODE=false
SIMULATION_MODE=false

# Forking (for testing)
FORK_BLOCK_NUMBER=latest
FORK_URL=https://arb1.arbitrum.io/rpc

# Mock Data
USE_MOCK_PRICES=false
USE_MOCK_SEQUENCER=false
USE_MOCK_COMPLIANCE=false

# ========================================
# Database & Storage
# ========================================
DATABASE_URL=postgresql://user:pass@localhost/arbitrum_mev
REDIS_URL=redis://localhost:6379
STORAGE_PROVIDER=local                      # local, s3, ipfs

# Data Retention
TRANSACTION_HISTORY_DAYS=90
PERFORMANCE_METRICS_DAYS=365
COMPLIANCE_RECORDS_YEARS=7

# ========================================
# API Configuration
# ========================================
API_ENABLED=true
API_PORT=8080
API_HOST=0.0.0.0
API_RATE_LIMIT=1000                         # requests per hour

# Authentication
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
AUTH_ENABLED=true

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ========================================
# External Services
# ========================================
# Price Feeds
CHAINLINK_ENABLED=true
PYTH_ENABLED=true
UNISWAP_ORACLE_ENABLED=true

# Analytics
DUNE_API_KEY=your_dune_api_key
DEFILLAMA_API_KEY=your_defillama_api_key

# Notifications
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your/webhook
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ========================================
# Performance Optimization
# ========================================
# Connection Pooling
MAX_RPC_CONNECTIONS=50
RPC_TIMEOUT_MS=5000
RPC_RETRY_COUNT=3

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000

# Batch Processing
BATCH_SIZE=10
BATCH_TIMEOUT_MS=100

# ========================================
# Backup & Recovery
# ========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# Recovery
AUTO_RECOVERY_ENABLED=true
RECOVERY_TIMEOUT_MINUTES=10
CHECKPOINT_INTERVAL_MINUTES=5