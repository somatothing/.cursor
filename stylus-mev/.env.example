# Arbitrum MEV FlashSandwich System Configuration

# ========================================
# Network Configuration
# ========================================
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_TESTNET_RPC_URL=https://goerli-rollup.arbitrum.io/rpc
SEQUENCER_FEED_URL=wss://arb1-sequencer.arbitrum.io/feed
PRIVATE_KEY=your_private_key_here_without_0x_prefix
NETWORK=mainnet  # mainnet, testnet, local

# ========================================
# MEV Strategy Parameters
# ========================================
MAX_POSITION_SIZE=100000000000000000000      # 100 ETH in wei
MIN_PROFIT_THRESHOLD=1000000000000000        # 0.001 ETH in wei
MAX_SLIPPAGE_BP=500                          # 5% maximum slippage
DEFAULT_GAS_LIMIT=2000000                    # Default gas limit
MAX_GAS_PRICE=100000000000                   # 100 gwei max gas price

# Flash Sandwich Settings
SANDWICH_MIN_PROFIT_BP=10                    # 0.1% minimum profit margin
SANDWICH_MAX_SIZE=50000000000000000000       # 50 ETH max sandwich size
SANDWICH_EXECUTION_WINDOW_MS=250             # 250ms execution window

# Arbitrage Settings
ARBITRAGE_MIN_PROFIT_BP=5                    # 0.05% minimum arbitrage profit
ARBITRAGE_MAX_SIZE=25000000000000000000      # 25 ETH max arbitrage size
ARBITRAGE_SLIPPAGE_TOLERANCE_BP=200          # 2% slippage tolerance

# ========================================
# Risk Management
# ========================================
MAX_DAILY_LOSS=10000000000000000000          # 10 ETH in wei
MAX_DRAWDOWN_BP=2000                         # 20% maximum drawdown
VAR_CONFIDENCE=95                            # 95% Value at Risk confidence
CORRELATION_LIMIT_BP=8000                    # 80% correlation limit
VOLATILITY_THRESHOLD_BP=5000                 # 50% volatility threshold

# Position Sizing
KELLY_SAFETY_FACTOR=25                       # 25% of Kelly Criterion
MAX_POSITION_RISK_BP=200                     # 2% max risk per position
PORTFOLIO_HEAT=20                            # 20% portfolio heat

# ========================================
# Flash Loan Providers
# ========================================
# Aave V3
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD
AAVE_POOL_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb
